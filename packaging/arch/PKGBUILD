# Builds OmaMap from this checkout:  cd packaging/arch && makepkg -si
# It builds the working tree as it is, including uncommitted changes.
# Nothing is downloaded: the web libraries are vendored and hash-checked.
# For the AUR, replace the local source with the published git repository
# (pinned to a tag or commit) and give it a checksum.
pkgname=omamap
pkgver=0.3.2
pkgrel=1
pkgdesc="View GeoJSON, KML, GPX, CSV and shapefiles over street and satellite maps"
arch=(x86_64 aarch64)
url="https://github.com/thebytorsnowdog/omamap"
license=(MIT)
depends=(qt6-base qt6-webengine hicolor-icon-theme)
makedepends=(cmake)
checkdepends=(nodejs)

_src="$startdir/../.."

build() {
  cmake -S "$_src/host" -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "$_src"
  # Bundled libraries must be the pinned releases.
  (cd core/vendor && sha256sum --check --quiet SHA256SUMS)
  node --test tests/
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
